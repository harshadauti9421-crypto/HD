Q14(b) — Ratio to Moving Average
# Q14(b): Seasonal Components - Ratio to Moving Average

# Load AirPassengers Dataset
data("AirPassengers")

# Create Data Frame
df = data.frame(
  year=floor(time(AirPassengers)),
  month=cycle(AirPassengers),
  Passengers=as.numeric(AirPassengers)
)

# Create Date Column
df$date = as.Date(
  paste(df$year,
        df$month,
        "01",
        sep="-"),
  format="%Y-%m-%d"
)

# Sort Data by Date
df = df[order(df$date),]

# Set Date as Row Names
rownames(df) = df$date

# Create Time Series
ts = df$Passengers

# Calculate 12-Month Moving Average
library(zoo)

ma12 = rollmean(
  ts,
  k=12,
  align="center",
  fill=NA
)

# Calculate Ratio
ratio = (ts / ma12) * 100

# Create Month and Ratio Data Frame
ratio_df = data.frame(
  Month=df$month,
  Ratio=as.numeric(ratio)
)

# Remove Missing Values
ratio_df = na.omit(ratio_df)

# Average Ratio for Each Month
seasonal_rma = aggregate(
  Ratio ~ Month,
  data=ratio_df,
  FUN=mean
)

# Display Seasonal Ratios
seasonal_rma

# Normalize Seasonal Indices
seasonal_rma$Seasonal_Index =
  seasonal_rma$Ratio *
  (1200 / sum(seasonal_rma$Ratio))

# Display Normalized Seasonal Indices
print(seasonal_rma)

# Plot Seasonal Indices
plot(
  seasonal_rma$Month,
  seasonal_rma$Seasonal_Index,
  type="o",
  pch=16,
  xlab="Month",
  ylab="Seasonal Index",
  main="Seasonal Indices - Ratio-to-Moving-Average"
)

# Reference Line
abline(
  h=100,
  lty=2
)

